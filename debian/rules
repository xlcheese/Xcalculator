#!/usr/bin/make -f

%:
	dh $@ --with python3

# the program's modules are in their own folder: compile them on install, remove the
# compiled copies again on uninstall
override_dh_python3:
	dh_python3 /usr/lib/xcalculator

# the rates timer is switched on per person by Xcalculator itself (Preferences → Currency
# Converter), never for everyone when the package is installed
override_dh_installsystemduser:
