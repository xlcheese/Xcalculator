#: usr/lib/xcalculator/xcalculator.py:727
msgid ""
"Word size: click to cycle 64 → 32 → 16 → 8 bits.\n"
"Results wrap around like a real register."
msgstr ""

#: usr/lib/xcalculator/xcalculator.py:729
msgid ""
"Shift left: move the bits left, filling with 0.\n"
"1 << 4 = 16 (multiplies by 2 each step)"
msgstr ""

#: usr/lib/xcalculator/xcalculator.py:730
msgid ""
"Shift right: move the bits right, keeping the sign.\n"
"16 >> 2 = 4 (divides by 2 each step)"
msgstr ""

#: usr/lib/xcalculator/xcalculator.py:731
msgid ""
"Bitwise AND: 1 only where both bits are 1.\n"
"1100 AND 1010 = 1000"
msgstr ""

#: usr/lib/xcalculator/xcalculator.py:732
msgid ""
"Bitwise OR: 1 where either bit is 1.\n"
"1100 OR 1010 = 1110"
msgstr ""

#: usr/lib/xcalculator/xcalculator.py:733
msgid ""
"Bitwise XOR: 1 where the bits differ.\n"
"1100 XOR 1010 = 0110"
msgstr ""

#: usr/lib/xcalculator/xcalculator.py:734
msgid ""
"Bitwise NOT: flip every bit of the next number.\n"
"NOT 0 = -1 (all bits set)"
msgstr ""

#: usr/lib/xcalculator/xcalculator.py:735
msgid "NOT (a AND b)"
msgstr ""

#: usr/lib/xcalculator/xcalculator.py:736
