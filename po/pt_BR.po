msgstr "Clique primeiro em Baixar cotações no Conversor de moedas."

#: usr/lib/xcalculator/preferences.py:238
msgid "Needs Xcalculator installed from its package."
msgstr "Requer o Xcalculator instalado pelo pacote."

#: usr/lib/xcalculator/preferences.py:239
