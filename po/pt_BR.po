msgid "At least one mode stays on."
msgstr "Pelo menos um modo continua ativado."

#: usr/lib/xcalculator/preferences.py:219
#, python-brace-format
msgid "2.5 shows as {example}."
msgstr "2.5 aparece como {example}."

#: usr/lib/xcalculator/preferences.py:220
msgid "Pads answers with zeros to every decimal place."
msgstr "Completa os resultados com zeros até a última casa decimal."

#: usr/lib/xcalculator/preferences.py:230
msgid ""
"The same as the Auto Refresh button. Rates come from the European Central "
"Bank."
msgstr ""
"O mesmo que o botão Autoatualizar. As cotações vêm do Banco Central Europeu."

#: usr/lib/xcalculator/preferences.py:231
