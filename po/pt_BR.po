msgstr "Falha na impressão"

#: usr/lib/xcalculator/programmer.py:99
msgid "Shift amount must not be negative"
msgstr "O deslocamento não pode ser negativo"

#: usr/lib/xcalculator/programmer.py:189
msgid "Hexadecimal (base 16): digits 0-9 and A-F. FF = 255"
msgstr "Hexadecimal (base 16): dígitos 0-9 e A-F. FF = 255"

#: usr/lib/xcalculator/programmer.py:190
msgid "Decimal (base 10): ordinary numbers, shown with a sign"
msgstr "Decimal (base 10): números comuns, mostrados com sinal"

#: usr/lib/xcalculator/programmer.py:191
msgid "Octal (base 8): digits 0-7. 17 = 15"
msgstr "Octal (base 8): dígitos 0-7. 17 = 15"

#: usr/lib/xcalculator/programmer.py:192
msgid "Binary (base 2): digits 0 and 1. 1010 = 10"
msgstr "Binário (base 2): dígitos 0 e 1. 1010 = 10"

#: usr/lib/xcalculator/programmer.py:193
msgid ""
"Word size: click to cycle 64 → 32 → 16 → 8 bits.\n"
"Results wrap around like a real register."
msgstr ""
"Tamanho da palavra: clique para alternar 64 → 32 → 16 → 8 bits.\n"
"Os resultados dão a volta como em um registrador de verdade."

#: usr/lib/xcalculator/programmer.py:195
msgid ""
"Shift left: move the bits left, filling with 0.\n"
"1 << 4 = 16 (multiplies by 2 each step)"
msgstr ""
"Deslocar à esquerda: move os bits para a esquerda, preenchendo com 0.\n"
"1 << 4 = 16 (multiplica por 2 a cada passo)"

#: usr/lib/xcalculator/programmer.py:196
msgid ""
"Shift right: move the bits right, keeping the sign.\n"
"16 >> 2 = 4 (divides by 2 each step)"
msgstr ""
"Deslocar à direita: move os bits para a direita, mantendo o sinal.\n"
"16 >> 2 = 4 (divide por 2 a cada passo)"

#: usr/lib/xcalculator/programmer.py:197
msgid ""
"Bitwise AND: 1 only where both bits are 1.\n"
"1100 AND 1010 = 1000"
msgstr ""
"AND bit a bit: 1 só onde os dois bits são 1.\n"
"1100 AND 1010 = 1000"

#: usr/lib/xcalculator/programmer.py:198
msgid ""
"Bitwise OR: 1 where either bit is 1.\n"
"1100 OR 1010 = 1110"
msgstr ""
"OR bit a bit: 1 onde qualquer um dos bits é 1.\n"
"1100 OR 1010 = 1110"

#: usr/lib/xcalculator/programmer.py:199
msgid ""
"Bitwise XOR: 1 where the bits differ.\n"
"1100 XOR 1010 = 0110"
msgstr ""
"XOR bit a bit: 1 onde os bits são diferentes.\n"
"1100 XOR 1010 = 0110"

#: usr/lib/xcalculator/programmer.py:200
msgid ""
"Bitwise NOT: flip every bit of the next number.\n"
"NOT 0 = -1 (all bits set)"
msgstr ""
"NOT bit a bit: inverte todos os bits do número seguinte.\n"
"NOT 0 = -1 (todos os bits ligados)"

#: usr/lib/xcalculator/programmer.py:201
msgid "NOT (a AND b)"
msgstr "NOT (a AND b)"

#: usr/lib/xcalculator/programmer.py:202
msgid "NOT (a OR b)"
msgstr "NOT (a OR b)"

#: usr/lib/xcalculator/programmer.py:203
msgid "Remainder after whole-number division. 17 mod 5 = 2"
msgstr "Resto da divisão inteira. 17 mod 5 = 2"

#: usr/lib/xcalculator/programmer.py:204
msgid "Whole-number division; the remainder is dropped. 17 ÷ 5 = 3"
msgstr "Divisão inteira; o resto é descartado. 17 ÷ 5 = 3"

#: usr/lib/xcalculator/programmer.py:205
msgid "Change the sign (two's complement negate)"
msgstr "Troca o sinal (negação em complemento de dois)"

#: usr/lib/xcalculator/programmer.py:227
#, python-brace-format
msgid "Can't paste that in {base}"
msgstr "Não é possível colar isso em {base}"

#. Translators: under the Programmer display, e.g. "QWORD (64-bit, signed)  ·  typing in DEC"
#: usr/lib/xcalculator/programmer.py:252
#, python-brace-format
msgid "{word} ({bits}-bit, signed)  ·  typing in {base}"
msgstr "{word} ({bits} bits, com sinal)  ·  digitando em {base}"

#: usr/lib/xcalculator/programmer.py:435 usr/lib/xcalculator/programmer.py:437
msgid "Not a whole number"
msgstr "Não é um número inteiro"

#: usr/lib/xcalculator/scientific.py:37
msgid "round down to a whole number:  floor(2.7) = 2"
msgstr "arredonda para baixo até um inteiro:  floor(2.7) = 2"

#: usr/lib/xcalculator/scientific.py:38
msgid "round up to a whole number:  ceil(2.1) = 3"
msgstr "arredonda para cima até um inteiro:  ceil(2.1) = 3"

#: usr/lib/xcalculator/scientific.py:39
msgid "the whole-number part:  int(−2.7) = −2"
msgstr "a parte inteira:  int(−2.7) = −2"

#: usr/lib/xcalculator/scientific.py:40
msgid "the part after the decimal point:  frac(2.75) = 0.75"
msgstr "a parte depois do ponto decimal:  frac(2.75) = 0.75"

#: usr/lib/xcalculator/scientific.py:41
msgid "the sign:  −1, 0, or 1"
msgstr "o sinal:  −1, 0 ou 1"

#: usr/lib/xcalculator/scientific.py:42
msgid "logarithm base 2:  log₂(8) = 3"
msgstr "logaritmo na base 2:  log₂(8) = 3"

#: usr/lib/xcalculator/scientific.py:43
msgid "secant, 1 ÷ cos"
msgstr "secante, 1 ÷ cos"

#: usr/lib/xcalculator/scientific.py:44
msgid "cosecant, 1 ÷ sin"
msgstr "cossecante, 1 ÷ sin"

#: usr/lib/xcalculator/scientific.py:45
msgid "cotangent, cos ÷ sin"
msgstr "cotangente, cos ÷ sin"

#: usr/lib/xcalculator/scientific.py:49
msgid "Absolute value: the number without its sign.  |−5| = 5"
msgstr "Valor absoluto: o número sem o sinal.  |−5| = 5"

#: usr/lib/xcalculator/scientific.py:50
msgid ""
"Combinations: ways to choose r items from n when order doesn't matter.\n"
"5 nCr 2 = 10"
msgstr ""
"Combinações: maneiras de escolher r itens de n quando a ordem não importa.\n"
"5 nCr 2 = 10"

#: usr/lib/xcalculator/scientific.py:51
msgid ""
"Permutations: ways to arrange r items from n when order matters.\n"
"5 nPr 2 = 20"
msgstr ""
"Permutações: maneiras de organizar r itens de n quando a ordem importa.\n"
"5 nPr 2 = 20"

#: usr/lib/xcalculator/scientific.py:52
msgid "Round to the nearest whole number.  round(2.5) = 3"
msgstr "Arredonda para o inteiro mais próximo.  round(2.5) = 3"

#: usr/lib/xcalculator/scientific.py:53
msgid "More functions"
msgstr "Mais funções"

#: usr/lib/xcalculator/scientific.py:54
msgid "Remainder after division.  17 mod 5 = 2"
msgstr "Resto da divisão.  17 mod 5 = 2"

