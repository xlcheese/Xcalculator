msgstr ""
"As cotações serão atualizadas em segundo plano mesmo com o Xcalculator "
"fechado."

#: usr/lib/xcalculator/preferences.py:240
msgid "Rates will only refresh while Xcalculator is open."
msgstr "As cotações só serão atualizadas com o Xcalculator aberto."

#: usr/lib/xcalculator/preferences.py:249
