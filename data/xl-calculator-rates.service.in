# Refreshes the Currency Converter's exchange rates while xl-Calculator is closed.
# Started once a day by xl-calculator-rates.timer, which xl-Calculator switches on only when
# both "Refresh rates automatically" and "Also when xl-Calculator is closed" are on.
[Unit]
Description=Refresh xl-Calculator's exchange rates
Documentation=https://github.com/xlcheese/xl-calculator

[Service]
Type=oneshot
ExecStart=@BINDIR@/xl-calculator --refresh-rates
Nice=10
